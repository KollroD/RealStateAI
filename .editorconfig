# root
root = true

# rules
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# py files
[*.py]
indent_style = space
indent_size = 4

# cfg, web files
[*.{json,yml,yaml,html,css,js}]
indent_style = space
indent_size = 2

# makefile
[Makefile]
indent_style = tab
